{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['uid','email']) && newData.child('uid').val() === auth.uid"
        },
        "memories": {
          "$memoryId": {
            ".validate": "newData.hasChildren(['text','createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        },
        "chats": {
          "$chatId": {
            ".validate": "newData.hasChildren(['createdAt','userText','assistantText'])"
          }
        }
      }
    }
  }
}